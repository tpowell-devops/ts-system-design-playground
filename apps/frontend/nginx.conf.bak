# apps/frontend/nginx.conf
server {
    listen 80;
    server_name localhost;

    # Root folder for your built React app
    root /usr/share/nginx/html;
    index index.html;

    # Serve static assets directly
    location /assets/ {
        try_files $uri =404;
    }

    # Serve favicon or other top-level static files
    location = /favicon.ico { try_files $uri =404; }
    location = /manifest.json { try_files $uri =404; }

    # SPA fallback: redirect everything else to index.html
    location / {
        try_files $uri /index.html;
    }

    # Optional: enable gzip for faster loading
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 256;

    # Optional: caching for assets
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
        try_files $uri =404;
        expires 1y;
        access_log off;
    }
}